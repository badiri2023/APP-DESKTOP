<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="gameContainer" minHeight="700.0" minWidth="1200.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.CtrlGame">
   <children>
      <!-- Panel superior con marcador -->
      <HBox alignment="CENTER" spacing="100.0" style="-fx-background-color: #111111; -fx-border-color: #333333; -fx-border-width: 0 0 2 0;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="15.0" top="15.0" />
         </padding>
         
         <!-- Jugador 1 -->
         <VBox alignment="CENTER" spacing="5.0">
            <Label text="JUGADOR 1" style="-fx-text-fill: #ffffff;">
               <font>
                  <Font name="8bitOperatorPlus8-Regular" size="14.0" />
               </font>
            </Label>
            <Label fx:id="player1ScoreLabel" text="0" style="-fx-text-fill: #ffffff;">
               <font>
                  <Font name="8bitOperatorPlus8-Regular" size="24.0" />
               </font>
            </Label>
         </VBox>
         
         <!-- VS -->
         <Label text="VS" style="-fx-text-fill: #ffcc00;">
            <font>
               <Font name="8bitOperatorPlus8-Regular" size="18.0" />
            </font>
         </Label>
         
         <!-- Marcador central -->
         <Label fx:id="scoreLabel" text="0 : 0" style="-fx-text-fill: #ffffff;">
            <font>
               <Font name="8bitOperatorPlus8-Regular" size="32.0" />
            </font>
         </Label>
         
         <!-- VS -->
         <Label text="VS" style="-fx-text-fill: #ffcc00;">
            <font>
               <Font name="8bitOperatorPlus8-Regular" size="18.0" />
            </font>
         </Label>
         
         <!-- Jugador 2 -->
         <VBox alignment="CENTER" spacing="5.0">
            <Label text="JUGADOR 2" style="-fx-text-fill: #ffffff;">
               <font>
                  <Font name="8bitOperatorPlus8-Regular" size="14.0" />
               </font>
            </Label>
            <Label fx:id="player2ScoreLabel" text="0" style="-fx-text-fill: #ffffff;">
               <font>
                  <Font name="8bitOperatorPlus8-Regular" size="24.0" />
               </font>
            </Label>
         </VBox>
      </HBox>
      
      <!-- Canvas del juego -->
      <Canvas fx:id="gameCanvas" height="500.0" width="800.0" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="200.0" AnchorPane.topAnchor="80.0" />
      
      <!-- Panel inferior con controles -->
      <HBox alignment="CENTER" spacing="150.0" style="-fx-background-color: #111111; -fx-border-color: #333333; -fx-border-width: 2 0 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <padding>
            <Insets bottom="20.0" top="20.0" />
         </padding>
         
         <!-- Controles Jugador 1 -->
         <VBox alignment="CENTER" spacing="10.0">
            <Label text="CONTROLES JUGADOR 1" style="-fx-text-fill: #ffffff;">
               <font>
                  <Font name="8bitOperatorPlus8-Regular" size="12.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="5.0">
               <Label text="W / S" style="-fx-text-fill: #ffcc00; -fx-background-color: #333333; -fx-padding: 5 10 5 10; -fx-border-color: #666666;">
                  <font>
                     <Font name="8bitOperatorPlus8-Regular" size="12.0" />
                  </font>
               </Label>
               <Label text="↑ / ↓" style="-fx-text-fill: #ffcc00; -fx-background-color: #333333; -fx-padding: 5 10 5 10; -fx-border-color: #666666;">
                  <font>
                     <Font name="8bitOperatorPlus8-Regular" size="12.0" />
                  </font>
               </Label>
            </HBox>
         </VBox>
         
         <!-- Controles centrales -->
         <VBox alignment="CENTER" spacing="10.0">
            <Label text="INICIAR JUEGO" style="-fx-text-fill: #00ff00;">
               <font>
                  <Font name="8bitOperatorPlus8-Regular" size="12.0" />
               </font>
            </Label>
            <Label text="ESPACIO" style="-fx-text-fill: #ffcc00; -fx-background-color: #333333; -fx-padding: 5 15 5 15; -fx-border-color: #666666;">
               <font>
                  <Font name="8bitOperatorPlus8-Regular" size="14.0" />
               </font>
            </Label>
         </VBox>
         
         <!-- Controles Jugador 2 -->
         <VBox alignment="CENTER" spacing="10.0">
            <Label text="CONTROLES JUGADOR 2" style="-fx-text-fill: #ffffff;">
               <font>
                  <Font name="8bitOperatorPlus8-Regular" size="12.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="5.0">
               <Label text="I / K" style="-fx-text-fill: #ffcc00; -fx-background-color: #333333; -fx-padding: 5 10 5 10; -fx-border-color: #666666;">
                  <font>
                     <Font name="8bitOperatorPlus8-Regular" size="12.0" />
                  </font>
               </Label>
            </HBox>
         </VBox>
      </HBox>
      
      <!-- Mensaje de cuenta regresiva (overlay) -->
      <VBox fx:id="countdownOverlay" alignment="CENTER" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <Label fx:id="countdownLabel" text="3" style="-fx-text-fill: #ffffff; -fx-font-size: 72px;">
            <font>
               <Font name="8bitOperatorPlus8-Regular" size="72.0" />
            </font>
         </Label>
      </VBox>
   </children>
</AnchorPane>