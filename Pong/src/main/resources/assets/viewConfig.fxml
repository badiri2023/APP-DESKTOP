<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchor" minHeight="500.0" minWidth="600.0" 
            xmlns="http://javafx.com/javafx/19" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.client.CtrlConfig"
            style="-fx-background-color: linear-gradient(to bottom, #0f1f2d, #1e3a5f);">
   <children>
      <VBox alignment="CENTER" spacing="20" 
            AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" 
            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="PONG ARCADE" alignment="CENTER" textFill="#ff4754">
               <font>
                  <Font name="Segoe UI Black" size="48.0"/>
               </font>
               <effect>
                  <DropShadow color="#ff475480" radius="8.0"/>
               </effect>
               <VBox.margin>
                  <Insets top="30.0" bottom="20.0"/>
               </VBox.margin>
            </Label>

            <!-- Panel de configuración -->
            <VBox alignment="CENTER" spacing="15" 
                  style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 20; -fx-padding: 25; -fx-border-color: #2ed573; -fx-border-width: 2; -fx-border-radius: 20;">
               <effect>
                  <DropShadow color="#00000050" radius="10.0"/>
               </effect>
               
               <Label text="CONFIGURACIÓN DEL SERVIDOR" textFill="#2ed573" 
                      style="-fx-font-weight: bold; -fx-font-size: 22px;">
                  <effect>
                     <DropShadow color="#2ed57340" radius="4.0"/>
                  </effect>
               </Label>

               <!-- Campo Nombre del jugador -->
               <HBox alignment="CENTER" spacing="15">
                  <Label text="JUGADOR:" textFill="#ffffff" 
                         style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-min-width: 100;"/>
                  <TextField fx:id="txtPlayerName" promptText="Tu nombre de jugador" 
                             prefWidth="250" prefHeight="40"
                             style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 10; -fx-border-radius: 10; -fx-font-size: 14px; -fx-border-color: #ff4754; -fx-border-width: 2;"/>
               </HBox>

               <!-- Campo Protocolo -->
               <HBox alignment="CENTER" spacing="15">
                  <Label text="PROTOCOLO:" textFill="#ffffff" 
                         style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-min-width: 100;"/>
                  <TextField fx:id="txtProtocol" promptText="ws o wss" 
                             prefWidth="250" prefHeight="40"
                             style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 10; -fx-border-radius: 10; -fx-font-size: 14px; -fx-border-color: #ff4754; -fx-border-width: 2;"/>
               </HBox>

               <!-- Campo Host -->
               <HBox alignment="CENTER" spacing="15">
                  <Label text="SERVIDOR:" textFill="#ffffff" 
                         style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-min-width: 100;"/>
                  <TextField fx:id="txtHost" promptText="IP del servidor" 
                             prefWidth="250" prefHeight="40"
                             style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 10; -fx-border-radius: 10; -fx-font-size: 14px; -fx-border-color: #ff4754; -fx-border-width: 2;"/>
               </HBox>

               <!-- Campo Port -->
               <HBox alignment="CENTER" spacing="15">
                  <Label text="PUERTO:" textFill="#ffffff" 
                         style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-min-width: 100;"/>
                  <TextField fx:id="txtPort" promptText="3000" 
                             prefWidth="250" prefHeight="40"
                             style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 10; -fx-border-radius: 10; -fx-font-size: 14px; -fx-border-color: #ff4754; -fx-border-width: 2;"/>
               </HBox>

               <!-- Botón Conectar -->
               <Button text="CONECTAR AL PONG" fx:id="btnConnect" onAction="#connectToServer" 
                       prefWidth="280" prefHeight="45"
                       style="-fx-background-color: linear-gradient(to bottom, #ff4754, #e84118); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 25; -fx-border-radius: 25; -fx-border-color: #ffffff; -fx-border-width: 1;">
                  <effect>
                     <DropShadow color="#00000060" radius="6.0"/>
                  </effect>
               </Button>

               <!-- Label para mensajes -->
               <Label fx:id="txtMessage" textFill="#fffa65" 
                      style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-alignment: center;"/>
            </VBox>

            <!-- Botones Local / Proxmox -->
            <HBox alignment="CENTER" spacing="25">
               <Button text="CONFIG LOCAL" onAction="#setConfigLocal" 
                       prefWidth="140" prefHeight="35"
                       style="-fx-background-color: linear-gradient(to bottom, #2ed573, #1dd1a1); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-border-radius: 15;">
                  <effect>
                     <DropShadow color="#00000040" radius="4.0"/>
                  </effect>
               </Button>
               <Button text="CONFIG PROXMOX" onAction="#setConfigProxmox" 
                       prefWidth="140" prefHeight="35"
                       style="-fx-background-color: linear-gradient(to bottom, #3742fa, #5352ed); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-border-radius: 15;">
                  <effect>
                     <DropShadow color="#00000040" radius="4.0"/>
                  </effect>
               </Button>
            </HBox>

            <!-- Texto inferior -->
            <Label text="Configura la conexión y prepárate para el desafío PONG" 
                   textFill="#70a1ff" 
                   style="-fx-font-style: italic; -fx-font-size: 13px;">
               <VBox.margin>
                  <Insets top="20.0" bottom="30.0"/>
               </VBox.margin>
               <effect>
                  <DropShadow color="#00000030" radius="2.0"/>
               </effect>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>