<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="loadingContainer" minHeight="700.0" minWidth="1200.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.CtrlLoading">
   <children>
      <VBox alignment="CENTER" spacing="40.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets top="100.0" />
         </padding>
         
         <!-- Título de carga -->
         <Label fx:id="loadingText" text="CARGANDO PARTIDA..." style="-fx-text-fill: #ffffff;">
            <font>
               <Font name="8bitOperatorPlus8-Regular" size="36.0" />
            </font>
         </Label>
         
         <!-- Barra de progreso -->
         <ProgressBar fx:id="loadingBar" prefWidth="400.0" prefHeight="25.0" progress="0.0" />
         
         <!-- Mensaje secundario -->
         <Label text="PREPARANDO ARENA..." style="-fx-text-fill: #666666;">
            <font>
               <Font name="8bitOperatorPlus8-Regular" size="18.0" />
            </font>
         </Label>
         
         <!-- Espacio para animación o gráficos -->
         <VBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
            <Label text="🎮" style="-fx-text-fill: #ffffff; -fx-font-size: 48px;">
               <VBox.margin>
                  <Insets top="50.0" />
               </VBox.margin>
            </Label>
         </VBox>
         
         <!-- Footer -->
         <Label text="NO APAGAR EL SISTEMA" style="-fx-text-fill: #ff4444;">
            <font>
               <Font name="8bitOperatorPlus8-Regular" size="14.0" />
            </font>
            <VBox.margin>
               <Insets top="50.0" />
            </VBox.margin>
         </Label>
      </VBox>
   </children>
</AnchorPane>