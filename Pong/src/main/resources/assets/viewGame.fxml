<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="gameContainer" minHeight="700.0" minWidth="1200.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.CtrlGame">
   <children>
      <!-- Panel superior con marcador - SIN MARCADORES INDIVIDUALES -->
      <HBox alignment="CENTER" style="-fx-background-color: #111111; -fx-border-color: #333333; -fx-border-width: 0 0 2 0;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="20.0" top="20.0" />
         </padding>
         
         <!-- Columna izquierda - Solo nombre del jugador -->
         <VBox alignment="CENTER" prefWidth="400">
            <Label fx:id="player1Label" style="-fx-text-fill: #ffffff; -fx-font-size: 18px;" text="JUGADOR 1" wrapText="true" maxWidth="350" textAlignment="CENTER"/>
         </VBox>
         
         <!-- Marcador central -->
         <VBox alignment="CENTER" prefWidth="200">
            <Label fx:id="scoreLabel" style="-fx-text-fill: #ffffff; -fx-font-size: 32px; -fx-font-weight: bold;" text="0 : 0"/>
         </VBox>

         <!-- Columna derecha - Solo nombre del jugador -->
         <VBox alignment="CENTER" prefWidth="400">
            <Label fx:id="player2Label" style="-fx-text-fill: #ffffff; -fx-font-size: 18px;" text="JUGADOR 2" wrapText="true" maxWidth="350" textAlignment="CENTER"/>
         </VBox>
      </HBox>
      
      <!-- Contenedor centrado para el canvas -->
      <StackPane AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
         <Canvas fx:id="gameCanvas" height="500.0" width="800.0" />
      </StackPane>
      
      <!-- Mensaje de cuenta regresiva (overlay) -->
      <VBox fx:id="countdownOverlay" alignment="CENTER" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <Label fx:id="countdownLabel" style="-fx-text-fill: #ffffff; -fx-font-size: 72px;" text="3">
         </Label>
      </VBox>
   </children>
</AnchorPane>