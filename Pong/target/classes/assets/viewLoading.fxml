<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="loadingContainer" minHeight="700.0" minWidth="1200.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.client.CtrlLoading">
   <children>
      <VBox alignment="CENTER" spacing="40.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets top="80.0" />
         </padding>
         
         <!-- Título de carga -->
         <Label fx:id="loadingText" style="-fx-text-fill: #ffffff;" text="CARGANDO..."/>

         <Label fx:id="messageLabel" style="-fx-text-fill: #00ffff;" text="Mensaje temporal" visible="false"/>
         
         <!-- Barra de progreso -->
         <ProgressBar fx:id="loadingBar" prefWidth="400.0" progress="0.0" />
         
         <!-- Footer -->
         <VBox alignment="CENTER" spacing="5.0" VBox.vgrow="ALWAYS">
            <Label style="-fx-text-fill: #333333;" text="27 D 2025"/>
            <Label style="-fx-text-fill: #666666;" text="PREPARANDO PARTIDA..."/>
         </VBox>
      </VBox>
   </children>
</AnchorPane>